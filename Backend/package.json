    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "hardhat": "^3.21.2"
  }
